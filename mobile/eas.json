{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "corepack": true,
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "corepack": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "tvos": {
      "corepack": true,
      "distribution": "internal",
      "env": { "EXPO_TV": "1" },
      "ios": { "simulator": false }
    },
    "production": {
      "corepack": true,
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
