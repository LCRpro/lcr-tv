{
  "expo": {
    "name": "LCR TV",
    "slug": "iptv-perso",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "iptvperso",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#121110",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.perso.iptv"
    },
    "android": {
      "package": "fr.perso.iptv"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-secure-store",
      "./plugins/withAndroidTv"
    ],
    "extra": {
      "apiUrl": "http://192.168.1.15:3001"
    }
  }
}
