{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "sync": "tsx src/cli/sync.ts",
    "provider": "tsx src/cli/provider.ts",
    "seed:admin": "tsx src/cli/seed-admin.ts",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "epg": "tsx src/cli/epg.ts",
    "tmdb": "tsx src/cli/tmdb.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.1.0",
    "@fastify/rate-limit": "^10.2.2",
    "@iptv/shared": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.38.4",
    "fastify": "^5.2.1",
    "fastify-plugin": "^6.0.0",
    "postgres": "^3.4.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "drizzle-kit": "^0.30.2",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
