# Les dependances de pair optionnelles ne s'installent pas toutes seules.
#
# pnpm 9 les installe par defaut. Resultat : `expo-router` declare Reanimated,
# Gesture Handler et @expo/ui en pairs optionnels — l'application n'en utilise
# aucun — et pnpm les a tires quand meme, avec Reanimated 4.6 qui exige
# `react-native-worklets` 0.12.x. Or `expo-modules-core` du SDK 57 compile son
# pont worklets contre l'API de la 0.10 : le build Android echouait sur
# « no member named 'executeSync' in 'worklets::WorkletRuntime' », apres six
# minutes de compilation C++ pour du code que personne n'appelle.
#
# Les vraies dependances, elles, sont declarees dans les package.json.
auto-install-peers=false
