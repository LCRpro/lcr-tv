# Postgres (docker compose expose 5433 pour ne pas entrer en conflit avec une instance locale)
DATABASE_URL=postgres://iptv:iptv@localhost:5433/iptv

# Clé maître de chiffrement des credentials provider (AES-256-GCM).
# 32 bytes en hex ou base64 : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=

# Secret de signature des tickets de lecture (HMAC-SHA256), >= 32 bytes.
TICKET_SECRET=

SESSION_TTL_DAYS=30
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Origines autorisées pour le front web (cookies cross-site en dev)
WEB_ORIGIN=http://localhost:3000

# URL par laquelle les clients joignent le backend, ecrite dans les manifests
# reecrits. Sur un reseau local, mettre l'IP de la machine et non localhost :
# sinon un telephone cherchera les segments sur son propre localhost.
PUBLIC_URL=http://localhost:3001

# Phase 8
TMDB_API_KEY=

# Inscription en libre-service.
#
# Chaque compte apporte ses propres abonnements : un nouvel inscrit n'entame les
# connexions simultanees de personne, il arrive avec les siennes. C'est ce qui
# rend `open` tenable sur une installation familiale.
#
#   open   n'importe qui peut creer un compte (defaut)
#   code   il faut connaitre SIGNUP_CODE
#   closed seul l'administrateur cree les comptes
#
# Passez a `code` des que l'application est joignable depuis l'exterieur.
SIGNUP_MODE=open
SIGNUP_CODE=
